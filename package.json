      "import": "./dist/tradable-sdk.js",
      "require": "./dist/tradable-sdk.js",
      "types": "./dist/lib/providers/providers.d.ts"
    },
    "./contexts": {
      "import": "./dist/tradable-sdk.js",
      "require": "./dist/tradable-sdk.js",
      "types": "./dist/lib/contexts/contexts.d.ts"
    },
    "./types": {
      "import": "./dist/tradable-sdk.js",
      "require": "./dist/tradable-sdk.js",
      "types": "./dist/lib/types/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
