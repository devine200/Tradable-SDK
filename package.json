{
  "name": "tradable-sdk",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/tradable-sdk.umd.cjs",
  "module": "./dist/tradable-sdk.js",
  "types": "./dist/tradable-sdk.d.ts",
  "exports": {
    ".": {
      "import": "./dist/tradable-sdk.js",
      "require": "./dist/tradable-sdk.js"
    },
