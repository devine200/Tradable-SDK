    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-storybook": "^0.11.2",
    "globals": "^15.14.0",
    "storybook": "^8.5.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.2",
    "undici-types": "^7.2.3",
